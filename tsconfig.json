{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "@types/bun"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
}